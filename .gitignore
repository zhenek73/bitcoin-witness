node_modules/
.env
.env.*
*.log
/target
/build
*.wasm
*.abi
!contracts/**/*.abi.example
.DS_Store
Thumbs.db

# One-off run output. Every debugging session leaves these behind; none of them
# belong in history. Real transcripts worth keeping live in docs/ under an
# explicit name (see docs/demo-transcript-2026-09-01.txt).
*.err
*.bak

# Container/state snapshots. Large, machine-specific, and never reproducible
# from the repo -- the devnet backup lives outside the working tree on purpose.
*.tar

# Outreach drafts. These are written for a specific audience and are unposted
# until they are posted; an unfinished one read as a project document would
# misrepresent the project. PITCH.md, the submission pitch, is deliberately not
# matched here.
PITCH-*.md
